<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>JellyRoulette.Tests</AssemblyName>
    <RootNamespace>JellyRoulette.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
  </ItemGroup>

  <!--
    El proyecto del plugin usa <ExcludeAssets>runtime</ExcludeAssets> (imprescindible:
    esos ensamblados los pone el servidor). Para poder EJECUTAR los tests necesitamos
    las DLL de Jellyfin en la carpeta de salida del proyecto de test, así que aquí las
    referenciamos de nuevo sin excluir nada. No afecta al publish del plugin.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Jellyfin.Plugin.JellyRoulette/Jellyfin.Plugin.JellyRoulette.csproj" />
  </ItemGroup>

</Project>
